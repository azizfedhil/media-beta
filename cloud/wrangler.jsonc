{
  "name": "pear-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pear-pair",
      "database_id": "a1ea9a53-bcac-4617-8fff-7e320ee042a1",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "PAIR_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PARTY",
        "class_name": "PartyRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PartyRoom"]
    }
  ]
}
